<?php

/**
 * Default error-page view shipped by contenir/errors-laminas-mvc.
 *
 * Variables (set by the listener):
 *   $status int    HTTP status code (e.g. 404)
 *   $title  string Plain-text title authored in admin (or the package default)
 *   $body   string Sanitised HTML fragment (inline only)
 *
 * Override by setting `errors.view_template` to a Site-owned template name.
 * Self-contained on purpose: no layout, neutral system fonts, inline styles —
 * the page renders even if the consumer's asset pipeline is broken.
 */

$status = (int) ($status ?? 500);
$title  = (string) ($title ?? '');
$body   = (string) ($body ?? '');
$head   = $title !== '' ? $title : sprintf('Error %d', $status);
?><!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title><?= $this->escapeHtml($head) ?></title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; min-height: 100vh; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                "Helvetica Neue", Arial, sans-serif;
            background: #fafafa;
            color: #1f1f1f;
            line-height: 1.5;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 2rem 1.5rem;
        }
        .fault__status {
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            font-size: 0.8125rem;
            color: #6b6b6b;
            margin: 0 0 1rem;
        }
        .fault__title {
            font-weight: 600;
            font-size: clamp(1.5rem, 4vw, 2.25rem);
            line-height: 1.2;
            margin: 0 0 1rem;
            max-width: 36rem;
        }
        .fault__body {
            font-size: 1rem;
            max-width: 36rem;
            margin: 0 0 2rem;
            color: #4a4a4a;
        }
        .fault__body p { margin: 0 0 1rem; }
        .fault__body p:last-child { margin-bottom: 0; }
        .fault__body a { color: #1f1f1f; }
        .fault__home {
            display: inline-block;
            color: #1f1f1f;
            background: transparent;
            text-decoration: none;
            font-weight: 600;
            letter-spacing: 0.05em;
            font-size: 0.875rem;
            padding: 0.75rem 1.5rem;
            border: 0.0625rem solid #1f1f1f;
            transition: background 0.15s ease, color 0.15s ease;
        }
        .fault__home:hover,
        .fault__home:focus {
            background: #1f1f1f;
            color: #fafafa;
        }
    </style>
</head>
<body class="fault fault--<?= $status ?>">
    <p class="fault__status"><?= $this->escapeHtml(sprintf('Error %d', $status)) ?></p>
    <?php if ($title !== ''): ?>
        <h1 class="fault__title"><?= $this->escapeHtml($title) ?></h1>
    <?php endif ?>
    <?php if ($body !== ''): ?>
        <div class="fault__body"><?= $body /* trusted HTML authored by admin */ ?></div>
    <?php endif ?>
    <a class="fault__home" href="/">Return home</a>
</body>
</html>
